{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/workspace/layout,_N_T_/workspace/activity/layout,_N_T_/workspace/activity/page,_N_T_/workspace/activity"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/workspace/activity/__PAGE__",
    "/workspace/activity",
    "/workspace",
    "/_index",
    "/_head"
  ]
}