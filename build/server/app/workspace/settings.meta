{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/workspace/layout,_N_T_/workspace/settings/layout,_N_T_/workspace/settings/page,_N_T_/workspace/settings"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/workspace/settings/__PAGE__",
    "/workspace/settings",
    "/workspace",
    "/_index",
    "/_head"
  ]
}