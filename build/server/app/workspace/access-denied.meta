{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/workspace/layout,_N_T_/workspace/access-denied/layout,_N_T_/workspace/access-denied/page,_N_T_/workspace/access-denied"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/workspace/access-denied/__PAGE__",
    "/workspace/access-denied",
    "/workspace",
    "/_index",
    "/_head"
  ]
}