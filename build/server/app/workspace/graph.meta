{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/workspace/layout,_N_T_/workspace/graph/layout,_N_T_/workspace/graph/page,_N_T_/workspace/graph"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/workspace/graph/__PAGE__",
    "/workspace/graph",
    "/workspace",
    "/_index",
    "/_head"
  ]
}